# 服务端模型预设：glm（默认）/ deepseek / qwen / kimi / openai
# 全部为 OpenAI 兼容接口，按需要填一个或多个密钥
MODEL_PROVIDER=glm

# 智谱 GLM（默认，glm-4-flash 免费） https://open.bigmodel.cn/
GLM_API_KEY=

# DeepSeek https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 通义千问（百炼，兼容模式） https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Kimi（Moonshot） https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# OpenAI https://platform.openai.com/
OPENAI_API_KEY=

# 单 IP 每日请求上限（内存限流，默认 50）
RATE_LIMIT_PER_DAY=50

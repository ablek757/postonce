# 服务端模型预设：glm（默认）/ deepseek / qwen / kimi / openai
# 全部为 OpenAI 兼容接口，按需要填一个或多个密钥
MODEL_PROVIDER=glm

# 智谱 GLM（默认，glm-4-flash 免费） https://open.bigmodel.cn/
GLM_API_KEY=

# DeepSeek https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 通义千问（百炼，兼容模式） https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# Kimi（Moonshot） https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# OpenAI https://platform.openai.com/
OPENAI_API_KEY=

# ---------- 视频/播客转写（ASR） ----------
# ASR 预设：dashscope（默认，阿里云百炼 qwen3-asr-flash）/ groq / openai
# dashscope 预设复用上面的 DASHSCOPE_API_KEY，无需重复填写
ASR_PROVIDER=dashscope
# 自定义 ASR 服务（OpenAI 兼容 /audio/transcriptions，或 dashscope 兼容模式）：
# 三个全填则覆盖预设；ASR_PROVIDER=dashscope 时按 qwen-asr 协议请求
# ASR_BASE_URL=
# ASR_API_KEY=
# ASR_MODEL=
# 视频/播客时长上限（分钟，默认 90）
MEDIA_MAX_MINUTES=90
# 直链媒体下载体积上限（MB，默认 300）
MEDIA_MAX_DOWNLOAD_MB=300
# 额外允许的音视频平台域名（逗号分隔，可选）
# MEDIA_EXTRA_HOSTS=xiaoyuzhoufm.com,example.com

# 单 IP 每日请求上限（内存限流，默认 50）
RATE_LIMIT_PER_DAY=50
